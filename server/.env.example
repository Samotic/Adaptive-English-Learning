# Copy to server/.env and fill in the values.

# ===== Required =====
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=english
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production. Without it (in development) everyone is logged out on each restart.
JWT_SECRET=

# ===== Server =====
NODE_ENV=development
PORT=4000
JWT_EXPIRES_IN=7d
# Allowed browser origins for CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the client, used in emails (verification links)
APP_URL=http://localhost:5173
# Serve client/dist from this server (single-server deployment after "npm run build")
SERVE_CLIENT=false
# Set to 1 when running behind one reverse proxy (Render, Heroku, nginx...)
TRUST_PROXY=
# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# ===== Optional: AI features (Google Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Personalized AI feedback after every answer (uses more API quota)
ENABLE_AI_FEEDBACK=false

# ===== Optional: Google sign-in =====
# OAuth 2.0 Web client ID from Google Cloud Console; add http://localhost:5173 as an authorized JavaScript origin
GOOGLE_CLIENT_ID=

# ===== Optional: email notifications (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Adaptive English <no-reply@example.com>"

# ===== Data retention (days) =====
TRAINING_DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365
